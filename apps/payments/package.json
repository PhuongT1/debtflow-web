{
  "name": "@debtflow/payments",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 3002 --proxy-config proxy.conf.json --headers 'Access-Control-Allow-Origin=*'",
    "start": "ng serve --port 3002 --proxy-config proxy.conf.json --headers 'Access-Control-Allow-Origin=*'",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "ng lint",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:standalone": "npm run dev"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/elements": "^22.1.3",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@debtflow/contracts": "*",
    "@debtflow/design-tokens": "*",
    "@debtflow/platform-sdk": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
