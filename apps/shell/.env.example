AUTH_SECRET="change-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Comma-separated public origins that may receive a post-login redirect.
AUTH_ALLOWED_RETURN_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
API_BASE_URL="http://localhost:4000/api"

# The default topology is packages/mfe-registry/src/manifest.json.
# Override only when testing another manifest.
# MFE_MANIFEST_PATH="../../packages/mfe-registry/src/manifest.json"

# Runtime locations stay outside the manifest so each environment can deploy
# every app independently. Names are declared by the versioned manifest.
PARTNER_OPS_ENABLED="true"
PARTNER_OPS_ORIGIN="http://localhost:3001"

PAYMENTS_ENABLED="true"
PAYMENTS_ORIGIN="http://localhost:3002"
