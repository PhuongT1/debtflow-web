{
  "name": "debtflow-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n shell,partner-ops -c blue,green \"npm run dev:shell\" \"npm run dev:partner-ops\"",
    "dev:shell": "npm run dev -w @debtflow/shell",
    "dev:partner-ops": "npm run dev -w @debtflow/partner-ops",
    "build": "npm run build --workspaces --if-present",
    "build:shell": "npm run build -w @debtflow/shell",
    "build:partner-ops": "npm run build -w @debtflow/partner-ops",
    "lint:shell": "npm run lint -w @debtflow/shell",
    "lint:partner-ops": "npm run lint -w @debtflow/partner-ops",
    "typecheck:shell": "npm run typecheck -w @debtflow/shell",
    "typecheck:partner-ops": "npm run typecheck -w @debtflow/partner-ops",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-frontend-boundaries.mjs",
    "clean": "rimraf apps/*/.next apps/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "clean:shell": "rimraf apps/shell/.next apps/shell/tsconfig.tsbuildinfo",
    "clean:partner-ops": "rimraf apps/partner-ops/.next apps/partner-ops/tsconfig.tsbuildinfo",
    "check": "npm run clean && npm run check:boundaries && npm run lint && npm run typecheck && npm run build",
    "check:shell": "npm run clean:shell && npm run check:boundaries && npm run lint:shell && npm run typecheck:shell && npm run build:shell",
    "check:partner-ops": "npm run clean:partner-ops && npm run check:boundaries && npm run lint:partner-ops && npm run typecheck:partner-ops && npm run build:partner-ops",
    "start:shell": "npm run start -w @debtflow/shell",
    "start:partner-ops": "npm run start -w @debtflow/partner-ops"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=20.0.0", "npm": ">=10.0.0" }
}
